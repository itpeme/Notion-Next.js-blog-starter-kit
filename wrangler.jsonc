{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "custom-worker.ts",
  "alias": {
    "notion-client": "./packages/notion-client/index.ts",
    "notion-utils": "./packages/notion-utils/index.ts",
    "notion-types": "./packages/notion-types/index.ts"
  },
  "name": "itpe-blog",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "define": { "process.env.NODE_ENV": "\"production\"" },
  "vars": {
    // robots.txt(SSR)가 운영 배포를 구분하는 값. 없으면 전체 크롤링 차단이 나간다.
    "SITE_ENV": "production"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "services": [
    {
      // 자기 자신을 호출하는 서비스 바인딩 (이름은 위 name 과 같아야 함)
      "binding": "WORKER_SELF_REFERENCE",
      "service": "itpe-blog"
    }
  ],
  "r2_buckets": [
    {
      // 배포 전에 버킷을 만들어야 한다: wrangler r2 bucket create itpe-blog-opennext-cache
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "itpe-blog-opennext-cache"
    }
  ],
  "durable_objects": { "bindings": [{ "name": "BLOG_REFRESH", "class_name": "BlogRefreshJob" }] },
  "migrations": [{ "tag": "blog-refresh-v1", "new_sqlite_classes": ["BlogRefreshJob"] }]
}
